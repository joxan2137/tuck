#include <winver.h>

#pragma code_page(65001)

#ifdef TUCK_HAS_ICON
1 ICON "tuck.ico"
#endif

1 24 "tuck.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION TUCK_VERSION_MAJOR, TUCK_VERSION_MINOR, TUCK_VERSION_PATCH, 0
PRODUCTVERSION TUCK_VERSION_MAJOR, TUCK_VERSION_MINOR, TUCK_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Tuck"
            VALUE "FileDescription", "Tuck"
            VALUE "FileVersion", TUCK_VERSION_STRING
            VALUE "InternalName", "tuck"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "tuck.exe"
            VALUE "ProductName", "Tuck"
            VALUE "ProductVersion", TUCK_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
